# ==========================================
# ARCANA - The Archive of Possibilities
# Environment Configuration
# ==========================================

# Google Gemini API Key (optional - full rulebase functions without it)
GEMINI_API_KEY=

# Gemini model identifier (free-tier compatible Flash model)
# Recommended: gemini-3.8-flash or gemini-2.0-flash
GEMINI_MODEL=gemini-3.1-flash-lite

# Toggle AI interpretation layer (default: true)
GEMINI_ENABLED=true

# AI Request Timeout in milliseconds
GEMINI_TIMEOUT_MS=15000

# Mock AI mode for offline local development testing (optional)
MOCK_AI=false

# ==========================================
# ARCANA Admin Dashboard & Visitor Tracking
# ==========================================
# Secret Admin PIN for /admin console (default: arcana2026)
ADMIN_PIN=arcana2026

# Supabase PostgreSQL Cloud integration (optional)
# If omitted, ARCANA automatically uses fast local/serverless fallback storage
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# or SUPABASE_ANON_KEY=

